@startuml
title Sequence Diagram - Warrior vs Goblin Scenario

actor Player

participant ConsoleUI
participant GameController
participant BattleEngine
participant Warrior
participant Goblin
participant DefendAction
participant BasicAttackAction
participant ShieldBashSkill
participant Potion

loop Each turn / round sequence

== Player chooses Defend ==
Player -> ConsoleUI : chooseDefend()
ConsoleUI -> GameController : submitAction("Defend")
GameController -> BattleEngine : processPlayerAction()
BattleEngine -> DefendAction : execute()
DefendAction -> Warrior : applyDefendEffect()

== Goblin turn ==
BattleEngine -> Goblin : takeTurn()
alt Goblin is stunned
    BattleEngine -> Goblin : skipTurn()
else Goblin can act
    Goblin -> BasicAttackAction : execute()
    BasicAttackAction -> Warrior : receiveReducedDamage()
end

== Player uses Shield Bash ==
Player -> ConsoleUI : chooseShieldBash()
ConsoleUI -> GameController : submitAction("Shield Bash")
GameController -> BattleEngine : processPlayerAction()
BattleEngine -> ShieldBashSkill : execute()
ShieldBashSkill -> Goblin : applyStun()

== Goblin next turn ==
BattleEngine -> Goblin : takeTurn()
alt Goblin is stunned
    BattleEngine -> Goblin : skipTurn()
else Goblin can act
    Goblin -> BasicAttackAction : execute()
    BasicAttackAction -> Warrior : receiveDamage()
end

== Player uses Potion ==
Player -> ConsoleUI : chooseItem("Potion")
ConsoleUI -> GameController : submitAction("Potion")
GameController -> BattleEngine : processPlayerAction()
BattleEngine -> Potion : use()
Potion -> Warrior : heal()

== Goblin next turn ==
BattleEngine -> Goblin : takeTurn()
alt Goblin is stunned
    BattleEngine -> Goblin : skipTurn()
else Goblin can act
    Goblin -> BasicAttackAction : execute()
    BasicAttackAction -> Warrior : receiveDamage()
end

== Player uses Basic Attack ==
Player -> ConsoleUI : chooseBasicAttack()
ConsoleUI -> GameController : submitAction("BasicAttack")
GameController -> BattleEngine : processPlayerAction()
BattleEngine -> BasicAttackAction : execute()
BasicAttackAction -> Goblin : reduceHpToZero()

end

@enduml