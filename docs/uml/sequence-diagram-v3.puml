@startuml
title SC2002 Turn-Based Combat Arena - Sequence Diagram

skinparam sequenceMessageAlign center
skinparam ParticipantPadding 25
skinparam BoxPadding 10
skinparam ResponseMessageBelowArrow true
skinparam maxMessageSize 70

actor Player
boundary BattleUI as UI
control GameController
control BattleEngine
control TurnManager
control ActionResolver
entity Warrior
entity Goblin
entity DefendEffect
entity StunEffect
entity Potion

Player -> UI : start battle
UI -> GameController : initializeGame()
GameController -> BattleEngine : startBattle()
BattleEngine -> TurnManager : beginRound()

== Turn 1: Goblin basic attack ==
TurnManager -> ActionResolver : resolveEnemyAttack(Goblin, Warrior)
ActionResolver -> Goblin : getAttackValue()
Goblin --> ActionResolver : attack
ActionResolver -> Warrior : getDefenseValue()
Warrior --> ActionResolver : defense
ActionResolver -> Warrior : receiveDamage(rawDamage)
ActionResolver --> TurnManager : attack resolved
TurnManager -> UI : displayAttackResult()

== Turn 2: Warrior defends ==
UI -> TurnManager : selectAction(Defend)
TurnManager -> ActionResolver : resolveDefend(Warrior)
ActionResolver -> Warrior : applyEffect(DefendEffect)
ActionResolver --> TurnManager : defend resolved
TurnManager -> UI : displayDefendResult()

== Turn 3: Goblin basic attack against defended Warrior ==
TurnManager -> ActionResolver : resolveEnemyAttack(Goblin, Warrior)
ActionResolver -> Goblin : getAttackValue()
Goblin --> ActionResolver : attack
ActionResolver -> Warrior : getModifiedDefenseValue()
Warrior --> ActionResolver : boosted defense
ActionResolver -> Warrior : receiveDamage(reducedDamage)
ActionResolver --> TurnManager : reduced attack resolved
TurnManager -> UI : displayReducedDamageResult()

== Turn 4: Warrior uses Shield Bash ==
UI -> TurnManager : selectAction(Shield Bash)
TurnManager -> ActionResolver : resolveSkill(Warrior, Goblin)
ActionResolver -> Goblin : receiveDamage(skillDamage)
ActionResolver -> Goblin : applyEffect(StunEffect)
ActionResolver --> TurnManager : skill resolved
TurnManager -> UI : displaySkillResult()

== Turn 5: Goblin is stunned ==
TurnManager -> Goblin : canAct()
Goblin --> TurnManager : false
TurnManager -> UI : displaySkipTurn("Goblin is stunned")

== Turn 6: Warrior uses Potion ==
UI -> TurnManager : selectAction(Use Potion)
TurnManager -> ActionResolver : resolveItemUse(Warrior, Potion)
ActionResolver -> Warrior : heal()
ActionResolver --> TurnManager : item resolved
TurnManager -> UI : displayHealResult()

== Turn 7: Goblin is still stunned ==
TurnManager -> Goblin : canAct()
Goblin --> TurnManager : false
TurnManager -> UI : displaySkipTurn("Goblin is stunned")

== Turn 8: Warrior basic attacks and defeats Goblin ==
UI -> TurnManager : selectAction(Basic Attack)
TurnManager -> ActionResolver : resolvePlayerAttack(Warrior, Goblin)
ActionResolver -> Warrior : getAttackValue()
Warrior --> ActionResolver : attack
ActionResolver -> Goblin : receiveDamage(finalDamage)
ActionResolver -> Goblin : isAlive()
Goblin --> ActionResolver : false
ActionResolver --> TurnManager : goblin defeated
TurnManager -> UI : displayDefeatResult()

BattleEngine -> UI : displayBattleOutcome()
@enduml
